NEXTAUTH_URL=http://localhost:4002
APP_URL=http://localhost:4002
NEXT_INTERNAL_APP_URL=http://127.0.0.1:4002

NEXTAUTH_SECRET=

# GlitchTip error tracking (same DSN/project for local/dev/prod, differentiated by NEXT_PUBLIC_APP_ENV)
NEXT_PUBLIC_GLITCHTIP_DSN=
# Set per deployment: local | development | production (set via CapRover app env vars on dev/prod)
NEXT_PUBLIC_APP_ENV=local

DATABASE_URL=postgresql://admin:admin@localhost:5433/unicis_platform
GLITCHTIP_DSN=
GLITCHTIP_TRACES_SAMPLE_RATE=0.01
GLITCHTIP_SEND_DEFAULT_PII=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# Backend base URL used server-side (Next.js API routes)
FLEET_API_URL=https://fleet.dev.unicis.tech/
# Backend host used by proxy helpers (without protocol)
FLEET_API_HOST=fleet.dev.unicis.tech
# Client-side Fleet URL (browser requests)
NEXT_PUBLIC_FLEET_API_URL=https://fleet.dev.unicis.tech/
# Client-side Fleet host (for proxy mode, no protocol)
NEXT_PUBLIC_FLEET_API_HOST=fleet.dev.unicis.tech

# Development-only Fleet UI mock (see lib/fleet/mock/README.md)
# NEXT_PUBLIC_FLEET_MODE=mock
# NEXT_PUBLIC_FLEET_MOCK_SCENARIO=default

# Shared token between unicis-platform and unicis.fleet
FLEET_SERVICE_TOKEN=rZTFtfNuSMajLnfFrWT2PZ3lX8WZv7W/Xs2H8hkEY6g=

# Enrollment defaults
OSQUERY_AGENT_VERSION=5.4.1
NEXT_PUBLIC_ASSET_REQUIRED_PLAN=ULTIMATE
ASSET_REQUIRED_PLAN=ULTIMATE

SVIX_URL=https://api.eu.svix.com
SVIX_API_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RETRACED_URL=
RETRACED_API_KEY=
RETRACED_PROJECT_ID=

AUTH_PROVIDERS=credentials,saml
GROUP_PREFIX=boxyhq-
CONFIRM_EMAIL=false
DISABLE_NON_BUSINESS_EMAIL_SIGNUP=false

HIDE_LANDING_PAGE=false
NEXT_PUBLIC_DARK_MODE=false

FEATURE_TEAM_SSO=true
FEATURE_TEAM_DSYNC=true
FEATURE_TEAM_AUDIT_LOG=true
FEATURE_TEAM_WEBHOOK=true
FEATURE_TEAM_API_KEY=true
FEATURE_TEAM_FLEET_CONNECT=true
FEATURE_TEAM_FLEET_PACK=true
FEATURE_TEAM_FLEET_QUEUE=true
FEATURE_TEAM_FLEET_TAG=true
