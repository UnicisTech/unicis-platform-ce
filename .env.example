# Backend base URL used server-side (Next.js API routes)
FLEET_API_URL=http://localhost:3010
# Backend host used by proxy helpers (without protocol)
FLEET_API_HOST=localhost:3010
# Client-side Fleet URL (browser requests)
NEXT_PUBLIC_FLEET_API_URL=http://localhost:3010
# Client-side Fleet host (for proxy mode, no protocol)
NEXT_PUBLIC_FLEET_API_HOST=localhost:3010

# Shared token between unicis-platform and unicis.fleet
FLEET_SERVICE_TOKEN=

# Enrollment defaults
